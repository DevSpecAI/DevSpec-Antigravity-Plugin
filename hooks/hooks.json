{
  "description": "When DevSpec remote control is active, mirror turns via Stop/UserPromptSubmit if the host supports these events.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./hooks/scripts/mirror-turn.mjs\" stop",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./hooks/scripts/mirror-turn.mjs\" user_prompt",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
